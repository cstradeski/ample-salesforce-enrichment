<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Amplemarket API</label>
    <allowedNamespaces></allowedNamespaces>
    <calloutOptions>
        <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
        <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
        <generateAuthorizationHeader>true</generateAuthorizationHeader>
    </calloutOptions>
    <endpoint>https://api.amplemarket.com</endpoint>
    <externalCredential>Amplemarket_External</externalCredential>
    <parameters>
        <parameterName>Authorization</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>{!$Credential.Amplemarket_External.AuthHeader}</parameterValue>
    </parameters>
</NamedCredential>
