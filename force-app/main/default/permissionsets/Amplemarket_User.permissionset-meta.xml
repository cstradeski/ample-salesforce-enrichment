<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows running the Amplemarket enrichment action from a record page or list view.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Amplemarket User</label>
    <license>Salesforce</license>

    <classAccesses>
        <apexClass>AmplemarketEnrichInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketEnrichmentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketBatchEnrichQueueable</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>Enrichment_Log__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Enrichment_Log__c.Record_Id__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Object_API_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Endpoint__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Request_Payload__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Response_Payload__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Error_Message__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Credits_Used__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Run_Timestamp__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Batch_Request_Id__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <externalCredentialPrincipalAccesses>
        <externalCredentialPrincipal>Amplemarket_External-AmplemarketBearer</externalCredentialPrincipal>
        <enabled>true</enabled>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
