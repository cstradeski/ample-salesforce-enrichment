    </classAccesses>

    <classAccesses>
        <apexClass>AmplemarketEnrichmentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketCreditPreview</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <customPermissions>
        <enabled>true</enabled>
        <name>Manage_Amplemarket_Settings</name>
    </customPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>Run_Amplemarket_Enrichment</name>
    </customPermissions>

    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>ample__Amplemarket_External-AmplemarketBearer</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>

