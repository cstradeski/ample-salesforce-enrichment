<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to Amplemarket Enrichment configuration and audit data.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Amplemarket Admin</label>
    <license>Salesforce</license>

    <applicationVisibilities>
        <application>Amplemarket_Enrichment</application>
        <visible>true</visible>
    </applicationVisibilities>

    <tabSettings>
        <tab>Amplemarket_Settings</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Enrichment_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <classAccesses>
        <apexClass>AmplemarketSettingsController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketMetadataDeployer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketEnrichInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AmplemarketEnrichmentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <customPermissions>
        <enabled>true</enabled>
        <name>Manage_Amplemarket_Settings</name>
    </customPermissions>

    <objectPermissions>
        <object>Enrichment_Log__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Enrichment_Log__c.Record_Id__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Object_API_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Endpoint__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Request_Payload__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Response_Payload__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Error_Message__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Credits_Used__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Run_Timestamp__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Enrichment_Log__c.Batch_Request_Id__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <externalCredentialPrincipalAccesses>
        <externalCredentialPrincipal>Amplemarket_External-AmplemarketBearer</externalCredentialPrincipal>
        <enabled>true</enabled>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
