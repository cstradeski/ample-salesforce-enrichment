<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to Amplemarket Enrichment configuration and audit data.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Amplemarket Admin</label>
    <license>Salesforce</license>

    <applicationVisibilities>
        <application>Amplemarket_Enrichment</application>
        <visible>true</visible>
    </applicationVisibilities>

    <tabSettings>
        <tab>Amplemarket_Settings</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Amplemarket_Auto_Enrichment</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Amplemarket_Credit_Tracking</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Enrichment_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <classAccesses>
        <apexClass>AmplemarketSettingsController</apexClass>
        <enabled>true</enabled>
