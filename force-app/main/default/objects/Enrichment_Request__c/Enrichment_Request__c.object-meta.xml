<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Queue of enrichment requests raised by automated flows. Drained by the Amplemarket automated enrichment job, which runs as the admin who enabled it — so the user who triggered the flow needs no Amplemarket permissions.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Enrichment Request</label>
    <nameField>
        <displayFormat>ER-{0000000}</displayFormat>
        <label>Enrichment Request Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Enrichment Requests</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
